class LibraryItem:
    def __init__(self, title, item_id):
        self.title = title
        self.item_id = item_id
        self.available = True

    def check_out(self):
        if self.available:
            self.available = False
            return f"'{self.title}' видано"
        return f"'{self.title}' вже видано"

    def return_item(self):
        self.available = True
        return f"'{self.title}' повернено"

    def get_details(self):
        return f"{self.title}"


class Book(LibraryItem):
    def __init__(self, title, item_id, author, pages):
        super().__init__(title, item_id)
        self.author = author
        self.pages = pages

    def get_details(self):
        return f"Book: \"{self.title}\" by {self.author}, {self.pages} pages"


class Magazine(LibraryItem):
    def __init__(self, title, item_id, issue_number, month):
        super().__init__(title, item_id)
        self.issue_number = issue_number
        self.month = month

    def get_details(self):
        return f"Magazine: \"{self.title}\", Issue {self.issue_number}, {self.month}"


class DVD(LibraryItem):
    def __init__(self, title, item_id, duration, director):
        super().__init__(title, item_id)
        self.duration = duration
        self.director = director

    def get_details(self):
        return f"DVD: \"{self.title}\", {self.duration} min, director: {self.director}"



items = [
    Book("Python Programming", "B001", "John Doe", 400),
    Magazine("Tech Today", "M001", 15, "Січень"),
    DVD("Python Tutorial", "D001", 120, "Jane Smith")
]

for item in items:
    print(item.get_details())

print()
book = items[0]
print(book.check_out())
print(book.return_item())
